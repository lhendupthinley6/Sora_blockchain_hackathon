SORA_MODE=ndi
PORT=3030
PUBLIC_BASE_URL=https://your-public-url

# Issued by the Bhutan NDI team for live verifier/issuer access.
NDI_CLIENT_ID=replace-with-ndi-client-id
NDI_CLIENT_SECRET=replace-with-ndi-client-secret

# Live transport.
# Use `nats` to avoid webhook registration.
# Use `webhook` if your tenant requires callback delivery instead.
NDI_TRANSPORT=nats
NDI_NATS_SERVER=wss://natsdemoclient.bhutanndi.com

# Optional override. The app defaults to the demo NATS nkey from the PDF.
# NDI_NATS_NKEY=

# Only needed when NDI_TRANSPORT=webhook.
# Chosen and owned by this app for webhook OAuth.
NDI_WEBHOOK_ID=sora-academic-demo
WEBHOOK_CLIENT_ID=sora-demo-webhook
WEBHOOK_CLIENT_SECRET=sora-demo-webhook-secret
